# =============================================================================
# Hidden directories — editor, tooling, caches, virtualenvs, agent runtime.
# Every dot-prefixed directory is local/generated, so none are tracked.
# Covers: .venv .idea .claude .mypy_cache .pytest_cache .ruff_cache .next .vercel
#         .tox .nox .hypothesis .pyre .pytype .pixi .eggs .ipynb_checkpoints
#         .spyproject .ropeproject .webassets-cache .scrapy .pybuilder .abstra
#         .transcripts .runtime .memory .task_outputs .tasks .teams .mailboxes
#         .worktrees  …and any future dot-folder.
# Dot-FILES (.env, .gitignore, .env.example, …) are NOT matched by this rule.
# =============================================================================
.*/

# --- Byte-compiled / compiled ---
__pycache__/
*.py[codz]
*$py.class
*.so

# --- Distribution / packaging ---
build/
dist/
eggs/
*.egg-info/
*.egg
MANIFEST
.installed.cfg
bytemaker/cargo.lock

# --- PyInstaller ---
*.manifest
*.spec

# --- Installer logs ---
pip-log.txt
pip-delete-this-directory.txt

# --- Test / coverage ---
htmlcov/
cover/
coverage.xml
*.cover
nosetests.xml

# --- Secrets / environment (dot-files) ---
.env
.envrc
.env*.local
.pypirc

# --- Type-checker / coverage / runtime state (dot-files) ---
.coverage
.coverage.*
.dmypy.json
dmypy.json
.pdm-python
.scheduled_tasks.json

# --- Python envs (non-dot names; .venv is covered by .*/ above) ---
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Django / Flask / DB ---
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/

# --- Docs / site ---
docs/_build/
/site

# --- Jupyter / IPython ---
profile_default/
ipython_config.py

# --- Misc Python ---
__pypackages__/
celerybeat-schedule
celerybeat.pid
*.sage.py
*.mo
*.pot
target/
cython_debug/

# --- Marimo ---
marimo/_static/
marimo/_lsp/
__marimo__/

# --- Web app ---
web/node_modules/
web/out/
# Root-only accidental lockfile; web/package-lock.json is tracked.
/package-lock.json

# --- Project-local analysis artifacts (not learning material) ---
analysis/
analysis_progress.md
test_providers.py

# --- ch5 evals: run reports are local artifacts; cassettes ARE tracked ---
evals/runs/
